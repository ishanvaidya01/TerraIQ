# TerraIQ (CarbonTrack AI) environment variables
# Copy this file to .env and replace placeholders with your own values.
# Never commit .env.

# Optional: Google Gemini API key for AI-assisted analysis.
# Without a valid key, TerraIQ runs in statistical mode.
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Express server port (defaults to 5000).
# If you change this, also update API_BASE_URL in public/app.js.
PORT=5000

# Optional: environment label.
NODE_ENV=development
